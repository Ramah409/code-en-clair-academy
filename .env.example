# =====================================================================
# Code en Clair Academy — variables d'environnement
# Copier ce fichier en .env puis remplacer les valeurs. Ne jamais committer .env.
# =====================================================================

# --- PostgreSQL ---
POSTGRES_DB=cda_academy
POSTGRES_USER=cda_academy
POSTGRES_PASSWORD=change-moi-mot-de-passe-base
# Port exposé sur le Mac (5433 pour ne pas entrer en conflit avec un PostgreSQL local)
POSTGRES_HOST_PORT=5433

# --- Backend Spring Boot ---
# Secret de signature des JWT : au moins 64 caractères aléatoires.
# Générer avec : openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=remplace-moi-par-une-longue-chaine-aleatoire-d-au-moins-soixante-quatre-caracteres
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# Origines autorisées par CORS (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081
BACKEND_HOST_PORT=8090
# Mot de passe du rôle PostgreSQL restreint du laboratoire SQL (accès au seul schéma « lab »)
LAB_DB_PASSWORD=change-moi-mot-de-passe-laboratoire

# --- Frontend (Nginx) ---
FRONTEND_HOST_PORT=8081

# --- Tuteur IA local (Ollama, gratuit, sans clé API) ---
# Dans Docker Compose, le backend joint Ollama via le nom de service "ollama".
# En lancement local (hors Docker), utiliser http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_HOST_PORT=11434
